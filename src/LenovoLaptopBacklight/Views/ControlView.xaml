<UserControl x:Class="LenovoLaptopBacklight.Views.ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LenovoLaptopBacklight.Localization"
             xmlns:vm="clr-namespace:LenovoLaptopBacklight.ViewModels">
    <UserControl.DataContext>
        <vm:ControlViewModel/>
    </UserControl.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Tr control.title}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr control.subtitle}" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Current state -->
        <Border Grid.Row="1" Background="#F3F3F3" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Tr control.current}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentRawValue}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>
                <TextBlock Text=" → " VerticalAlignment="Center" Foreground="Gray"/>
                <TextBlock Text="{Binding CurrentStage.Name, FallbackValue='—'}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0078D4"/>
                <Button Content="{loc:Tr control.refresh}" Command="{Binding ReadCurrentCommand}"
                        Margin="16,0,0,0" Padding="10,4" IsEnabled="{Binding IsConfigured}"/>
            </StackPanel>
        </Border>

        <!-- Stage buttons or not-configured message -->
        <Grid Grid.Row="2">
            <!-- Not configured overlay -->
            <Border Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVisInverse}}"
                    Background="#FFF8E1" CornerRadius="6" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{loc:Tr control.noRegTitle}" FontWeight="SemiBold" Foreground="#E65100"/>
                    <TextBlock Text="{loc:Tr control.noRegBody}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Stage buttons -->
            <ItemsControl ItemsSource="{Binding Stages}"
                          Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.ApplyStageCommand,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Margin="0,0,12,12" Padding="20,10" MinWidth="100"
                                Background="#0078D4" Foreground="White" FontSize="14"
                                FontWeight="SemiBold">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Value, StringFormat='0x{0:X2}'}"
                                           HorizontalAlignment="Center" FontSize="11"
                                           Foreground="#CCE4FF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="Gray"
                   Margin="0,12,0,0" FontSize="12"/>
    </Grid>
</UserControl>
