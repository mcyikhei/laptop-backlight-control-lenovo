<UserControl x:Class="LenovoLaptopBacklight.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LenovoLaptopBacklight.Localization"
             xmlns:vm="clr-namespace:LenovoLaptopBacklight.ViewModels">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{loc:Tr settings.title}" FontSize="20" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Language -->
            <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                    Padding="16" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr settings.language}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              Width="140" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Apply on restart -->
            <Border Grid.Row="2" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="6"
                    Background="#F3F9FF" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr settings.applyOnRestart}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{loc:Tr settings.applyOnRestartDesc}"
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="{loc:Tr settings.onRestartSet}"
                                  IsChecked="{Binding RestartEnabled}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding StageNames}"
                                  SelectedItem="{Binding RestartStage}"
                                  Width="140" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Windows Defender / driver -->
                    <Separator Margin="0,12,0,10"/>
                    <TextBlock Text="{Binding DefenderStatus}" Foreground="Gray" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Tr settings.defenderAllow}"
                                Command="{Binding AddExclusionCommand}" Padding="10,4"/>
                        <Button Content="{loc:Tr settings.defenderRemove}"
                                Command="{Binding RemoveExclusionCommand}" Margin="8,0,0,0" Padding="10,4"/>
                    </StackPanel>
                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{loc:Tr settings.defenderNote}"/>
                </StackPanel>
            </Border>

            <!-- Register overrides -->
            <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                    Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr settings.ecAdvanced}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="{loc:Tr settings.ecAdvancedNote}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10" FontSize="12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr settings.primaryReg}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Register}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr settings.mirrorReg}" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding MirrorRegister}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Stages manager -->
            <Border Grid.Row="4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                    Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr settings.stages}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <DataGrid ItemsSource="{Binding Stages}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              MaxHeight="200" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr settings.colName}"  Binding="{Binding Name}"  Width="*"/>
                            <DataGridTextColumn Header="{loc:Tr settings.colValue}" Binding="{Binding Value}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Add stage -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox Text="{Binding NewStageName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="160" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                        <Button Content="{loc:Tr settings.addStage}" Command="{Binding AddStageCommand}" Padding="10,4"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Tr settings.saveChanges}" Command="{Binding SaveRegistersCommand}"
                                Padding="12,6" Background="#0078D4" Foreground="White" FontWeight="SemiBold"/>
                        <Button Content="{loc:Tr settings.resetDefaults}" Command="{Binding ResetDefaultsCommand}"
                                Margin="10,0,0,0" Padding="12,6" Foreground="#C62828"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Files & status -->
            <StackPanel Grid.Row="5">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{loc:Tr settings.openLog}" Command="{Binding OpenLogCommand}" Padding="10,4" Margin="0,0,8,0"/>
                    <Button Content="{loc:Tr settings.openConfig}" Command="{Binding OpenConfigCommand}" Padding="10,4"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="Gray" FontSize="12"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
