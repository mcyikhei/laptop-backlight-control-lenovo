<UserControl x:Class="LenovoLaptopBacklight.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LenovoLaptopBacklight.ViewModels">
    <UserControl.DataContext>
        <vm:AboutViewModel/>
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="680">

            <!-- App title -->
            <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Version}" Foreground="Gray" Margin="0,0,0,16"/>

            <!-- Author -->
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding AuthorHeader}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding AuthorLine}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding GitHubLabel}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center">
                            <Hyperlink Command="{Binding OpenRepoCommand}">github.com/mcyikhei/laptop-backlight-control-lenovo</Hyperlink>
                        </TextBlock>
                        <Button Content="{Binding CopyLabel}" Command="{Binding CopyRepoCommand}"
                                Margin="8,0,0,0" Padding="6,2" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="{Binding License}" Foreground="Gray" Margin="0,6,0,0" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- DISCLAIMER -->
            <Border Background="#FFF3E0" BorderBrush="#FF8F00" BorderThickness="1"
                    CornerRadius="6" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding DisclaimerTitle}" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" FontSize="12" LineHeight="20"/>
                </StackPanel>
            </Border>

            <!-- Credits -->
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="{Binding CreditsTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Credits}" TextWrapping="Wrap" FontSize="12"
                               FontFamily="Segoe UI" LineHeight="20"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
