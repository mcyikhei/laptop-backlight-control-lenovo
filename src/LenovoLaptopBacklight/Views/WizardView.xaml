<UserControl x:Class="LenovoLaptopBacklight.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LenovoLaptopBacklight.Localization"
             xmlns:vm="clr-namespace:LenovoLaptopBacklight.ViewModels">
    <UserControl.DataContext>
        <vm:WizardViewModel/>
    </UserControl.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Tr detection.title}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr detection.subtitle}"
                       Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Step panels -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Step 0: Intro -->
                <Border Visibility="{Binding Step, Converter={StaticResource EqToVis}, ConverterParameter=0}"
                        Background="#E3F2FD" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr detection.howTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Tr detection.howBody}" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Tr detection.readonly}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#C62828"/>
                        <Button Content="{loc:Tr detection.start}" Command="{Binding StartCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Padding="16,8" Background="#0078D4" Foreground="White"
                                FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Step 1: Capture -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EqToVis}, ConverterParameter=1}">
                    <TextBlock Text="{loc:Tr detection.step1}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding InstructionText}" TextWrapping="Wrap"
                               Background="#FFF8E1" Padding="10" Margin="0,0,0,10"/>

                    <!-- Stage checklist -->
                    <ItemsControl ItemsSource="{Binding CaptureStages}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock Text="{Binding StatusGlyph}" Width="24" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr detection.skipped}" Foreground="Gray" VerticalAlignment="Center"
                                               Visibility="{Binding Skipped, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Tr detection.capture}" Command="{Binding CaptureNextCommand}"
                                Padding="14,8" Background="#0078D4" Foreground="White" FontWeight="SemiBold"/>
                        <Button Content="{loc:Tr detection.skip}" Command="{Binding SkipCommand}"
                                Margin="10,0,0,0" Padding="14,8"/>
                        <Button Content="{loc:Tr detection.analyse}" Command="{Binding AnalyseCommand}"
                                Margin="10,0,0,0" Padding="14,8" Background="#2E7D32" Foreground="White" FontWeight="SemiBold"/>
                        <Button Content="{loc:Tr common.reset}" Command="{Binding ResetCommand}"
                                Margin="10,0,0,0" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: Results -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EqToVis}, ConverterParameter=2}">
                    <TextBlock Text="{loc:Tr detection.step2}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding CandidatesSummary}" TextWrapping="Wrap"
                               Background="#E8F5E9" Padding="10" Margin="0,0,0,10" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding CandidateList}" MaxHeight="160"
                             SelectedIndex="0" Margin="0,0,0,10" FontFamily="Consolas"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Tr detection.verify}" Command="{Binding VerifyCommand}"
                                Padding="14,8" Background="#0078D4" Foreground="White" FontWeight="SemiBold"/>
                        <Button Content="{loc:Tr common.reset}" Command="{Binding ResetCommand}"
                                Margin="10,0,0,0" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 3: Verify running (big live display) -->
                <Border Visibility="{Binding Step, Converter={StaticResource EqToVis}, ConverterParameter=3}"
                        Background="#1E1E1E" CornerRadius="8" Padding="24" MinHeight="200">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Tr detection.watch}" Foreground="#888" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,0,0,16" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Tr detection.nowShowing}" Foreground="#AAA" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding VerifyStageName}" Foreground="#4FC3F7"
                                   FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                        <TextBlock Text="{Binding VerifyStageDetail}" Foreground="#CCC" FontSize="13"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Step 4: Confirm (Save or Reset) -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EqToVis}, ConverterParameter=4}">
                    <TextBlock Text="{loc:Tr detection.step3}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <Border Background="#FFF8E1" Padding="14" CornerRadius="6" Margin="0,0,0,12">
                        <TextBlock Text="{loc:Tr detection.confirmQuestion}" TextWrapping="Wrap" FontSize="14"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Tr detection.saveYes}" Command="{Binding SaveCommand}"
                                Padding="14,8" Background="#2E7D32" Foreground="White" FontWeight="SemiBold"/>
                        <Button Content="{loc:Tr detection.resetNo}" Command="{Binding ResetCommand}"
                                Margin="10,0,0,0" Padding="14,8" Foreground="#C62828"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 5: Done -->
                <Border Visibility="{Binding Step, Converter={StaticResource EqToVis}, ConverterParameter=5}"
                        Background="#E8F5E9" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr detection.savedTitle}" FontWeight="SemiBold"
                                   FontSize="16" Foreground="#2E7D32" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Tr detection.savedBody}" TextWrapping="Wrap"/>
                        <Button Content="{loc:Tr detection.runAgain}" Command="{Binding ResetCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,6"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="Gray" FontSize="12" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
