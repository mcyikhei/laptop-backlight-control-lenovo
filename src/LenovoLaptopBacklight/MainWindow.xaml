<Window x:Class="LenovoLaptopBacklight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LenovoLaptopBacklight.Views"
        xmlns:loc="clr-namespace:LenovoLaptopBacklight.Localization"
        Title="{loc:Tr window.title}"
        Icon="appicon.ico"
        Height="560" Width="780" MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar accent -->
        <Border Grid.Row="0" Background="#0078D4" Height="4"/>

        <!-- Tab control -->
        <TabControl Grid.Row="1" TabStripPlacement="Left"
                    BorderThickness="0" Background="White">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="14,10"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="MinWidth" Value="130"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                        Background="Transparent" BorderThickness="0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabItem Header="{loc:Tr tab.control}">
                <views:ControlView/>
            </TabItem>
            <TabItem Header="{loc:Tr tab.detection}">
                <views:WizardView/>
            </TabItem>
            <TabItem Header="{loc:Tr tab.settings}">
                <views:SettingsView/>
            </TabItem>
            <TabItem Header="{loc:Tr tab.about}">
                <views:AboutView/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
